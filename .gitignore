# Private planning material — describes the real deployment environment and so
# never lands in the published tree. See also: published docs are genericized.
docs/plan.md
docs/pending-decisions.md

# Real overlays. A host list is a map of someone's network and this repository
# is published; deploy/*/overlays/example is the committed worked copy, the
# working one stays here. Also keeps the real users_database.yml — password
# hashes — from ever being staged.
/deploy/*/overlays/local/
users_database.yml
!**/users_database.example.yml

# Go build output
/scryglass
/dist/
*.test
coverage.out

# Local development databases
*.db
*.db-shm
*.db-wal

# Local environment
.env
.env.local

# Design source material. Concept sheets and mockups are large, are worked on
# outside this tree, and the published repository needs the exported assets
# rather than the sheets they came from.
/scryglass-concept-sheet.png
*-concept-sheet.png
/design/
/Screenshot*.png

# Logo masters. The derived assets under internal/server/assets are what ships;
# these are the full-resolution sources they were cut from, and they live
# outside the tree. Keep them somewhere safe — regenerating from a prompt will
# not produce the same instrument twice.
/full-mark.png
/app-icon.png
/micro-icon.png
